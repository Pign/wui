# What `mui init` writes as `build-wui.hxml`.
#
# It lives here rather than in `mui` because what a build for this backend needs
# -- which libraries, which generator macro, which output -- is ours to state,
# and `mui` had no way of keeping six of these honest. `$MAIN` is the only thing
# substituted.
-cp src
-lib mui
-lib wui
-lib kui
-lib nui
-lib rui
-D mui_backend=wui
--macro wui.macros.WinUIGenerator.register()
--macro mui.macros.Bind.all()
--macro wui.nui.Vocabulary.registerWithMui()
--macro wui.kui.Platform.registerWithKui()
--main $MAIN
# `build/cpp`, and it has to be exactly that: the generated .vcxproj links
# `..\cpp\lib<App>.lib` relative to `build/winui/`, and `tools/cli/Build.hx`
# looks for the library at that same path. A different output directory here
# fails at the link step with a missing .lib and no hint as to why.
-cpp build/cpp
